# ========================================================================
# Конфигурация Samba API Server v2.7
# ========================================================================

# ── 1. ОСНОВНЫЕ НАСТРОЙКИ СЕРВЕРА ─────────────────────────────────────
# Обязательное поле: API-ключ для аутентификации (сгенерируйте: python3 -c "import secrets; print(secrets.token_urlsafe(32))")
SAMBA_API_KEY=4568790uiohghfdrest54r67t8y9ui0opijhukygjhftdrertghj
# Арес и порт для запуска сервера
SAMBA_API_HOST=127.0.0.1
SAMBA_API_PORT=8099
# Исправление v18: TMPDIR должен быть /var/tmp для корректной работы samba-tool
TMPDIR=/var/tmp

# ── 2. НАСТРОЙКИ SAMBA ────────────────────────────────────────────────
# Путь к утилите samba-tool
SAMBA_TOOL_PATH=samba-tool
# Путь к конфигурационному файлу Samba
SAMBA_SMB_CONF=/etc/samba/smb.conf
# Адрес сервера Samba
SAMBA_SERVER=kushnrserveralt.kcrb.local
# Имя хоста контроллера домена (DC) для команд DNS и DRS RPC
SAMBA_DC_HOSTNAME=kushnrserveralt.kcrb.local
# URL TDB для доступа только для чтения к sam.ldb
SAMBA_TDB_URL=tdb:///var/lib/samba/private/sam.ldb
# Путь к файлу sam.ldb
SAMBA_TDB_SAM_LDB_PATH=/var/lib/samba/private/sam.ldb
# Размер пула воркеров (одновременные процессы samba-tool)
SAMBA_WORKER_POOL_SIZE=4
# Режим вывода JSON для команд samba-tool
SAMBA_JSON_MODE=text
# Домен и Realm
SAMBA_DOMAIN_DN=DC=kcrb,DC=local
SAMBA_REALM=kcrb.local

# ── 3. УЧЕТНЫЕ ДАННЫЕ SAMBA ──────────────────────────────────────────
# Данные для удаленного доступа
SAMBA_CREDENTIALS_USER=Administrator
SAMBA_CREDENTIALS_PASSWORD=
SAMBA_USE_KERBEROS=false

# ── 4. ЛОГИРОВАНИЕ ────────────────────────────────────────────────────
# Уровень логирования
SAMBA_LOG_LEVEL=INFO
# Формат логов v2.7: standard (удобно читать) или json (для ELK/Grafana)
SAMBA_LOG_FORMAT=standard

# ── 5. БЕЗОПАСНОСТЬ: JWT АУТЕНТИФИКАЦИЯ ──────────────────────────────
# Секретный ключ для подписи JWT. Генерируется автоматически, если пусто.
SAMBA_JWT_SECRET_KEY=
SAMBA_JWT_ALGORITHM=HS256
SAMBA_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
SAMBA_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── 6. БЕЗОПАСНОСТЬ: CORS ────────────────────────────────────────────
# Разрешенные источники через запятую. Пусто = разрешены все (*).
# Пример: https://admin.example.com,https://dc.example.com
SAMBA_CORS_ORIGINS=

# ── 7. БЕЗОПАСНОСТЬ: ОГРАНИЧЕНИЕ ЗАПРОСОВ (RATE LIMIT) ──────────────
SAMBA_RATE_LIMIT_ENABLED=true
SAMBA_RATE_LIMIT_AUTH_PER_MIN=10
SAMBA_RATE_LIMIT_READ_PER_MIN=100
SAMBA_RATE_LIMIT_WRITE_PER_MIN=30
SAMBA_RATE_LIMIT_SHELL_PROJET_PER_MIN=120
SAMBA_RATE_LIMIT_WINDOW_SECONDS=60

# ── 8. КЭШИРОВАНИЕ ───────────────────────────────────────────────────
SAMBA_CACHE_ENABLED=false #true
SAMBA_CACHE_TTL=3
SAMBA_CACHE_MAX_SIZE=512

# ── 9. БАЗЫ ДАННЫХ ───────────────────────────────────────────────────
# Путь к базе данных управления API
SAMBA_MGMT_DB_PATH=/var/lib/samba/api_mgmt.db

# ── 10. ВЫПОЛНЕНИЕ КОМАНД (SHELL) ───────────────────────────────────
SAMBA_SHELL_ENABLED=true
SAMBA_SHELL_MAX_TIMEOUT=600
# Заблокированные команды (через запятую)
SAMBA_SHELL_BLOCKED_COMMANDS=rm -rf /,mkfs.,dd if=,:(){ :|:& };:,fork bomb

# ── 11. ПРОЕКТЫ SHELL (ОСНОВНЫЕ НАСТРОЙКИ) ───────────────────────────
SAMBA_SHELL_PROJET_BASE_DIR=/home/AD-API-USER
SAMBA_SHELL_PROJET_MAX_PROJECTS=100
SAMBA_SHELL_PROJET_MAX_ARCHIVE_SIZE=500
SAMBA_SHELL_PROJET_ALLOWED_ARCHIVE_TYPES=.zip,.tar.gz,.tgz,.tar.bz2,.tar.xz,.tar,.gz,.7z
SAMBA_SHELL_PROJET_POOL_SIZE=8
SAMBA_SHELL_PROJET_DEFAULT_TIMEOUT=300
SAMBA_SHELL_PROJET_OWNER_DEFAULT=api-user
# Максимальный размер вывода stdout/stderr в байтах (по умолчанию: 5MB = 5242880)
# Если вывод превышает лимит, он будет обрезан с добавлением маркера
SAMBA_SHELL_PROJET_MAX_OUTPUT_SIZE=5242880
# Максимальный размер рабочего пространства в MB (0 = без лимита, по умолчанию: 500)
# Загрузка/распаковка будет отклонена, если превышен этот лимит
SAMBA_SHELL_PROJET_MAX_WORKSPACE_SIZE=500

# ── 12. ПРОЕКТЫ SHELL (POSTGRESQL) ──────────────────────────────────
# Подключение к PostgreSQL для хранения проектов
# База данных и пользователь должны быть созданы до запуска API.
# Настройка на ALT Linux:
#   su - postgres
#   createuser -P samba_api
#   createdb -O samba_api samba_api
SAMBA_SHELL_PROJET_PG_HOST=localhost
SAMBA_SHELL_PROJET_PG_PORT=5432
SAMBA_SHELL_PROJET_PG_DBNAME=samba_api
SAMBA_SHELL_PROJET_PG_USER=samba_api
SAMBA_SHELL_PROJET_PG_PASSWORD=12345
# Полный DSN (переопределяет отдельные параметры, если указан):
# SAMBA_SHELL_PROJET_PG_DSN=postgresql://samba_api:secret@localhost:5432/samba_api
SAMBA_SHELL_PROJET_PG_POOL_MIN=2
SAMBA_SHELL_PROJET_PG_POOL_MAX=10

# ── 13. ПРОЕКТЫ SHELL (ДОПОЛНИТЕЛЬНО) ───────────────────────────────
# Интервал очистки по TTL в секундах (по умолчанию: 30)
SAMBA_SHELL_PROJET_TTL_CLEANUP_INTERVAL=30
# Максимальное количество попыток повтора для вебхуков (по умолчанию: 3)
SAMBA_SHELL_PROJET_CALLBACK_MAX_RETRIES=3
# Ключ шифрования Fernet для encrypted_env (генерируется автоматически, если пусто)
# Генерация: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SAMBA_SHELL_PROJET_ENCRYPTION_KEY=
# Базовая директория для общих томов
SAMBA_SHELL_PROJET_SHARED_VOLUMES_DIR=/home/AD-API-USER/_shared

# ── 14. AI АССИСТЕНТ (ОБЩИЕ НАСТРОЙКИ) ──────────────────────────────
# Модель LLM по умолчанию для запросов AI
SAMBA_AI_DEFAULT_MODEL=openai/gpt-5.4-nano
# Температура LLM (0.0 = детерминированно, 2.0 = креативно)
SAMBA_AI_TEMPERATURE=0.7
# Максимальное количество токенов на запрос
SAMBA_AI_MAX_TOKENS=80593
# Базовый URL этого API-сервера (для получения /openapi.json)
SAMBA_AI_API_BASE=http://127.0.0.1:8099

# ── 15. AI АССИСТЕНТ (ЛИМИТЫ И РЕЗЕРВНЫЕ МОДЕЛИ) ───────────────────
# Максимальное количество повторных попыток при ошибке 429 (Rate Limit) (по умолчанию: 3)
SAMBA_AI_RATE_LIMIT_RETRIES=3 #1,2,3
# Максимальное время ожидания в секундах при повторе 429, ограничивает Retry-After провайдера (по умолчанию: 30)
SAMBA_AI_RATE_LIMIT_MAX_WAIT=30
# Резервные модели через запятую, если основная получает Rate Limit (по умолчанию: пусто)
# Примеры платных: openai/gpt-4o-mini,anthropic/claude-3-haiku
SAMBA_AI_FALLBACK_MODELS=z-ai/glm-4.7-flash,x-ai/grok-4.20,kwaipilot/kat-coder-pro-v2

# ── 16. AI АССИСТЕНТ (АГЕНТ И СХЕМЫ) ────────────────────────────────
# Максимальный размер сжатой схемы в символах, отправляемой в LLM (по умолчанию: 12000 ≈ 3000 токенов)
# При превышении схема постепенно обрезается: params → summaries → operationIds
# Меньше = дешевле/быстрее, но меньше контекста для AI
SAMBA_AI_MAX_SCHEMA_CHARS=120000
SAMBA_AI_AGENT_MAX_MENU_CHARS=80000
SAMBA_AI_AGENT_MAX_STEPS=60
SAMBA_AI_AGENT_EXPORT_DIR=/home/AD-API-USER/ai-exports
# Разрешить агенту выполнять команды Shell
SAMBA_AI_AGENT_SHELL_ENABLED=true
SAMBA_AI_AGENT_SHELL_TIMEOUT=30
SAMBA_AI_AGENT_SHELL_BLOCKED_CMDS=rm -rf /,mkfs.,dd if=,...

# ── 16b. AI DEBUG-ЛОГИРОВАНИЕ (v1.9.12) ──────────────────────────────
# Включить детальное логирование запросов/ответов AI на уровне INFO
# Показывает: model, messages, tools, extra_body → content, tool_calls, usage
# ВНИМАНИЕ: Логирует ВСЕ данные, включая маскированные PII-токены!
# Используйте только для отладки. По умолчанию: false
SAMBA_AI_DEBUG=true
# Максимальная длина (символов) для записей в debug-логе (0 = без лимита)
SAMBA_AI_DEBUG_MAX_CONTENT=3000

# ── AI СИСТЕМА: МАСКИРОВКА ДАННЫХ (PII Protection) ──────────────────
# Включить маскировку PII перед отправкой в облако AI (по умолчанию: true)
# Защищает реальные данные (имена, логины, email) от передачи в облако
SAMBA_AI_MASK_ENABLED=true
# Список полей для маскировки (через запятую, пусто = стандартный набор PII_FIELDS)
SAMBA_AI_MASK_FIELDS=
# Включить range-нотацию [MASK_field_1+N] для сжатия (по умолчанию: true)
SAMBA_AI_MASK_RANGE_NOTATION=true

# ── 17. AI ПРОВАЙДЕР: POLZA.AI (ОСНОВНЫЕ) ───────────────────────────
# Polza.ai — единственный AI-провайдер
# URL используется КАК ЕСТЬ — OpenAI SDK автоматически добавляет /chat/completions
# Документация API: https://polza.ai/docs/api-reference/chat/completions
SAMBA_POLZA_AI_URL=https://polza.ai/api/v1
SAMBA_POLZA_AI_KEY=
# Имя модели для Polza.ai (например: openai/gpt-4o, openai/gpt-oss-120b, anthropic/claude-3-5-sonnet)
SAMBA_POLZA_AI_MODEL=deepseek/deepseek-v4-flash

# ── 18. AI ПРОВАЙДЕР: POLZA.AI (МАРШРУТИЗАЦИЯ) ─────────────────────
# Управление тем, как Polza.ai направляет запросы к провайдерам инференса.
# Использовать ТОЛЬКО этих провайдеров (через запятую). Пример: Novita,OpenAI
# Оставьте пустым для авто-выбора провайдера платформой Polza.ai
SAMBA_POLZA_AI_PROVIDER_ONLY=
# Порядок приоритета провайдеров (через запятую). Пример: OpenAI,Anthropic,Novita
# Оставьте пустым для сортировки по умолчанию Polza.ai
SAMBA_POLZA_AI_PROVIDER_ORDER=
# Игнорировать этих провайдеров (через запятую). Пример: DeepInfra
# Эти провайдеры никогда не будут использоваться
SAMBA_POLZA_AI_PROVIDER_IGNORE=
# Разрешить переход на другие провайдеры, если основной недоступен (по умолчанию: true)
SAMBA_POLZA_AI_PROVIDER_ALLOW_FALLBACKS=true
# Стратегия сортировки для выбора провайдера. Варианты: price (сортировка по самой дешевой цене)
# Оставьте пустым для сортировки по умолчанию Polza.ai
SAMBA_POLZA_AI_PROVIDER_SORT=
# Максимальная цена за миллион токенов (в рублях). 0 = без лимита
# Цены на модели: https://polza.ai/docs/api-reference/models/catalog
SAMBA_POLZA_AI_PROVIDER_MAX_PRICE_PROMPT=50
SAMBA_POLZA_AI_PROVIDER_MAX_PRICE_COMPLETION=0

# ── 19. AI ПРОВАЙДЕР: POLZA.AI (REASONING / МОДЕЛИ РАССУЖДЕНИЙ) ────
# Поддержка объекта reasoning для моделей типа o1, o3, DeepSeek-R1 и т.д.
# Уровень усилий рассуждений: xhigh, high, medium, low, minimal, none
# Оставьте пустым, чтобы не отправлять параметр reasoning
SAMBA_POLZA_AI_REASONING_EFFORT=medium
# Детализация саммари рассуждений: auto, concise, detailed
# Оставьте пустым, чтобы не отправлять reasoning.summary
SAMBA_POLZA_AI_REASONING_SUMMARY=
# Включить/выключить рассуждения (по умолчанию: true, если указан effort)
SAMBA_POLZA_AI_REASONING_ENABLED=true
# Максимальное количество токенов для рассуждений (в стиле Anthropic, 0 = не отправляется)
# ВАЖНО: Если указан SAMBA_POLZA_AI_REASONING_EFFORT, то max_tokens ДОЛЖНО быть 0!
# Иначе Polza.ai API вернёт 400: "Only one of reasoning.effort and reasoning.max_tokens can be specified"
SAMBA_POLZA_AI_REASONING_MAX_TOKENS=0
# Скрыть рассуждения из ответа (модель думает, но не возвращает результат рассуждений)
SAMBA_POLZA_AI_REASONING_EXCLUDE=false

# ── 20. AI ПРОВАЙДЕР: POLZA.AI (ПАРАМЕТРЫ ГЕНЕРАЦИИ) ────────────────
# Расширения Polza.ai помимо стандартных параметров OpenAI.
# Параметр сэмплирования Top-K (0 = не отправляется, типичное значение: 50)
SAMBA_POLZA_AI_TOP_K=50
# Штраф за повторения (0.0 = не отправляется, типичное значение: 1.0)
SAMBA_POLZA_AI_REPETITION_PENALTY=1
# Переопределение сэмплирования Top-P для Polza.ai (0.0 = по умолчанию, типично: 0.7)
SAMBA_POLZA_AI_TOP_P=0.7
# Штраф за частоту (от -2.0 до 2.0, 0.0 = не отправляется)
# Штрафует токены в зависимости от того, как часто они встречаются
SAMBA_POLZA_AI_FREQUENCY_PENALTY=0
# Штраф за присутствие (от -2.0 до 2.0, 0.0 = не отправляется)
# Штрафует токены, которые уже появлялись ранее
SAMBA_POLZA_AI_PRESENCE_PENALTY=0
# Зерно (Seed) для детерминированной генерации (0 = не отправляется, детерминизм не гарантирован, но максимум усилий)
SAMBA_POLZA_AI_SEED=0

# ── 21. AI ПРОВАЙДЕР: POLZA.AI (ВЕБ-ПОИСК) ─────────────────────────
# Встроенный веб-поиск для моделей, которые его поддерживают
# Включить веб-поиск (по умолчанию: false)
SAMBA_POLZA_AI_WEB_SEARCH_ENABLED=false
# Размер контекста веб-поиска: low, medium, high (по умолчанию: medium)
SAMBA_POLZA_AI_WEB_SEARCH_CONTEXT_SIZE=medium

# ── 22. AI СИСТЕМА: ЧАТ ─────────────────────────────────────────────
SAMBA_AI_CHAT_ENABLED=true
SAMBA_AI_CHAT_MAX_HISTORY=100
SAMBA_AI_CHAT_MAX_PER_USER=20

# ── 23. AI СИСТЕМА: НАВЫКИ (SKILLS) ─────────────────────────────────
# Путь к директории с навыками AI (пусто = app/models/ai/SKILL/)
SAMBA_AI_SKILLS_DIR=
SAMBA_AI_SKILLS_ENABLED=true

# ── 24. SAMBA ШАРЫ (Управление через AI) ─────────────────────────────
SAMBA_SAMBA_SHARES_CONF=/etc/samba/smb.conf
SAMBA_SAMBA_SHARES_DIR=/srv/samba/shares

# ── 25. AI: РЕЖИМ ПРАВ ДОСТУПА ──────────────────────────────────────
# Если true, AI получает только список прав доступа вместо полной схемы API
SAMBA_AI_PERMISSION_MODE=true 